# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/linux_web_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=linux_web_db

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock
STORAGE_ROOT=/data/users
MAX_MEMORY_MB=512
MAX_CPU_CORES=1
MAX_PROCESSES=50

# Railway Configuration
RAILWAY_API_TOKEN=your_railway_token_here
RAILWAY_SERVICE_NAME=linux-web

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=production

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
