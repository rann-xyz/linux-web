{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/public/**",
      "use": "@vercel/static"
    },
    {
      "src": "backend/src/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/boot", "dest": "/boot.html" },
    { "src": "/login", "dest": "/login.html" },
    { "src": "/register", "dest": "/register.html" },
    { "src": "/terminal", "dest": "/terminal.html" },
    { "src": "/views/(.*)", "dest": "/$1.html" },
    {
      "src": "/static/(.*)",
      "dest": "/frontend/public/static/$1"
    }
  ]
}